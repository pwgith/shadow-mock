{
  "mappings": [
    {
      "id": "5d010001-5001-4000-8000-000000000001",
      "name": "Retry: 503 twice, then success",
      "metadata": { "corpus": "call-counts", "feature": "retry" },
      "request": { "method": "POST", "urlPath": "/sm/calls/payments" },
      "response": { "status": 200, "jsonBody": { "status": "SETTLED" } },
      "callResponses": [
        { "calls": "1-2", "response": { "status": 503, "headers": { "Retry-After": "0" }, "jsonBody": { "error": "temporarily_unavailable" } } }
      ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000002",
      "name": "Polling: PENDING three times, then COMPLETE",
      "metadata": { "corpus": "call-counts", "feature": "polling" },
      "request": { "method": "GET", "urlPath": "/sm/calls/jobs/7" },
      "response": { "status": 200, "jsonBody": { "jobId": 7, "state": "COMPLETE", "resultUrl": "/sm/calls/jobs/7/result" } },
      "callResponses": [
        { "calls": "1-3", "response": { "status": 200, "jsonBody": { "jobId": 7, "state": "PENDING" } } }
      ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000003",
      "name": "Selector: exactly the 3rd call",
      "metadata": { "corpus": "call-counts", "feature": "selector-single" },
      "request": { "method": "GET", "urlPath": "/sm/calls/third" },
      "response": { "status": 200, "body": "normal" },
      "callResponses": [ { "calls": "3", "response": { "status": 500, "body": "third call fails" } } ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000004",
      "name": "Selector: a range of calls",
      "metadata": { "corpus": "call-counts", "feature": "selector-range" },
      "request": { "method": "GET", "urlPath": "/sm/calls/range" },
      "response": { "status": 200, "body": "normal" },
      "callResponses": [ { "calls": "2-4", "response": { "status": 500, "body": "calls 2 to 4 fail" } } ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000005",
      "name": "Selector: open-ended (rate limit from the 6th call)",
      "metadata": { "corpus": "call-counts", "feature": "selector-open" },
      "request": { "method": "GET", "urlPath": "/sm/calls/rate-limited" },
      "response": { "status": 200, "jsonBody": { "quotaRemaining": true } },
      "callResponses": [ { "calls": "6+", "response": { "status": 429, "headers": { "Retry-After": "1" }, "jsonBody": { "error": "rate_limited" } } } ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000006",
      "name": "Selector: every 3rd call fails (flaky dependency)",
      "metadata": { "corpus": "call-counts", "feature": "selector-every" },
      "request": { "method": "GET", "urlPath": "/sm/calls/flaky" },
      "response": { "status": 200, "body": "ok" },
      "callResponses": [ { "every": 3, "response": { "status": 502, "body": "bad gateway" } } ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000007",
      "name": "Rule order: the first matching rule wins",
      "metadata": { "corpus": "call-counts", "feature": "rule-order", "expected": "200,200,418,200,429,500,429" },
      "request": { "method": "GET", "urlPath": "/sm/calls/order" },
      "response": { "status": 200 },
      "callResponses": [
        { "calls": "3", "response": { "status": 418 } },
        { "every": 3, "response": { "status": 500 } },
        { "calls": "5+", "response": { "status": 429 } }
      ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000008",
      "name": "Call number in a template",
      "metadata": { "corpus": "call-counts", "feature": "template" },
      "request": { "method": "GET", "urlPath": "/sm/calls/attempt" },
      "response": { "status": 200, "jsonBody": { "attempt": "{{request.callNumber}}" }, "transformers": ["response-template"] }
    },
    {
      "id": "5d010001-5001-4000-8000-000000000009",
      "name": "Rule responses with delay, file, fault and templating",
      "metadata": { "corpus": "call-counts", "feature": "rich-rules" },
      "request": { "method": "GET", "urlPath": "/sm/calls/rich" },
      "response": { "status": 200, "body": "default response" },
      "callResponses": [
        { "calls": "1", "response": { "status": 200, "fixedDelayMilliseconds": 300, "body": "slow first call" } },
        { "calls": "2", "response": { "status": 200, "bodyFileName": "session/claim-from-file.json", "headers": { "Content-Type": "application/json" } } },
        { "calls": "3", "response": { "fault": "CONNECTION_RESET_BY_PEER" } },
        { "calls": "4", "response": { "status": 200, "body": "call {{request.callNumber}} via {{request.method}}", "transformers": ["response-template"] } }
      ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000010",
      "name": "Only served requests count (header required)",
      "metadata": { "corpus": "call-counts", "feature": "counting" },
      "request": { "method": "GET", "urlPath": "/sm/calls/only-served", "headers": { "X-Go": { "equalTo": "yes" } } },
      "response": { "status": 200 },
      "callResponses": [ { "calls": "2", "response": { "status": 500 } } ]
    },
    {
      "id": "5d010001-5001-4000-8000-000000000011",
      "name": "Counter used by admin set/reset examples (500 on the 10th call)",
      "metadata": { "corpus": "call-counts", "feature": "counter-admin" },
      "request": { "method": "GET", "urlPath": "/sm/calls/tenth" },
      "response": { "status": 200 },
      "callResponses": [ { "calls": "10", "response": { "status": 500, "body": "tenth call" } } ]
    }
  ]
}
