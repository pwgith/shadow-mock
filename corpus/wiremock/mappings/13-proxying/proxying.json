{
  "mappings": [
    {
      "id": "c0130001-0013-4000-8000-000000000001",
      "name": "Proxy everything under /wm/proxy/payments to the upstream",
      "metadata": { "corpus": "proxying", "upstream": "http://localhost:8089" },
      "priority": 10,
      "request": { "method": "ANY", "urlPathPattern": "/wm/proxy/payments/.*" },
      "response": { "proxyBaseUrl": "http://localhost:8089" }
    },
    {
      "id": "c0130001-0013-4000-8000-000000000002",
      "name": "Partial mocking: one stubbed case wins over the proxy",
      "metadata": { "corpus": "proxying" },
      "priority": 1,
      "request": { "method": "POST", "urlPath": "/wm/proxy/payments/declined" },
      "response": { "status": 402, "jsonBody": { "error": "card_declined" } }
    },
    {
      "id": "c0130001-0013-4000-8000-000000000003",
      "name": "Proxy adding and removing request headers",
      "metadata": { "corpus": "proxying" },
      "request": { "method": "ANY", "urlPathPattern": "/wm/proxy/headers/.*" },
      "response": {
        "proxyBaseUrl": "http://localhost:8089",
        "additionalProxyRequestHeaders": { "X-Proxied-By": "shadow-mock-corpus", "Authorization": "Bearer upstream-token" },
        "removeProxyRequestHeaders": ["X-Internal-Secret", "Cookie"]
      }
    },
    {
      "id": "c0130001-0013-4000-8000-000000000004",
      "name": "Proxy stripping a URL prefix",
      "metadata": { "corpus": "proxying" },
      "request": { "method": "ANY", "urlPathPattern": "/wm/proxy/api/v1/.*" },
      "response": { "proxyBaseUrl": "http://localhost:8089", "proxyUrlPrefixToRemove": "/wm/proxy/api" }
    },
    {
      "id": "c0130001-0013-4000-8000-000000000005",
      "name": "Proxy target chosen by template",
      "metadata": { "corpus": "proxying" },
      "request": { "method": "GET", "urlPathPattern": "/wm/proxy/regional/.*" },
      "response": { "proxyBaseUrl": "http://{{request.headers.X-Region}}.upstream.test:8089", "transformers": ["response-template"] }
    }
  ]
}
