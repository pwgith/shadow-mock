{
  "mappings": [
    {
      "id": "c0090001-0009-4000-8000-000000000001",
      "name": "Status, status message, headers and a text body",
      "metadata": { "corpus": "responses" },
      "request": { "method": "GET", "urlPath": "/wm/responses/teapot" },
      "response": {
        "status": 418,
        "statusMessage": "I'm a teapot",
        "headers": { "Content-Type": "text/plain; charset=utf-8", "X-Trace-Id": "corpus-1", "Cache-Control": "no-store" },
        "body": "short and stout"
      }
    },
    {
      "id": "c0090001-0009-4000-8000-000000000002",
      "name": "jsonBody",
      "metadata": { "corpus": "responses" },
      "request": { "method": "GET", "urlPath": "/wm/responses/json" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": 1, "status": "OPEN", "tags": ["motor", "urgent"], "owner": { "name": "Ada" }, "settled": null }
      }
    },
    {
      "id": "c0090001-0009-4000-8000-000000000003",
      "name": "base64Body (decodes to 'hello')",
      "metadata": { "corpus": "responses" },
      "request": { "method": "GET", "urlPath": "/wm/responses/base64" },
      "response": { "status": 200, "headers": { "Content-Type": "application/octet-stream" }, "base64Body": "aGVsbG8=" }
    },
    {
      "id": "c0090001-0009-4000-8000-000000000004",
      "name": "Multi-value response header",
      "metadata": { "corpus": "responses" },
      "request": { "method": "GET", "urlPath": "/wm/responses/cookies" },
      "response": { "status": 200, "headers": { "Set-Cookie": ["session=s-abc; HttpOnly", "locale=en-AU"] }, "body": "two cookies set" }
    },
    {
      "id": "c0090001-0009-4000-8000-000000000005",
      "name": "Empty 204 response",
      "metadata": { "corpus": "responses" },
      "request": { "method": "DELETE", "urlPathPattern": "/wm/responses/claims/[0-9]+" },
      "response": { "status": 204 }
    },
    {
      "id": "c0090001-0009-4000-8000-000000000006",
      "name": "Redirect with a Location header",
      "metadata": { "corpus": "responses" },
      "request": { "method": "GET", "urlPath": "/wm/responses/old-location" },
      "response": { "status": 301, "headers": { "Location": "/wm/responses/json" } }
    },
    {
      "id": "c0090001-0009-4000-8000-000000000007",
      "name": "Server error with a problem+json body",
