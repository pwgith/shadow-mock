{
  "journal": ["GET", "/requests?limit=100"],
  "unmatched": ["GET", "/requests?unmatched=true&limit=100"],
  "nearMisses": ["POST", "/near-misses/request"],
  "sessions": ["GET", "/sessions"],
  "deleteSession": ["DELETE", "/sessions/{id}"],
  "updateSession": ["PATCH", "/sessions/{id}"],
  "keepAlive": ["POST", "/sessions/{id}/keepalive"],
  "dryRun": ["POST", "/mappings/dry-run"],
  "counters": ["GET", "/counters"],
  "sessionCounters": ["GET", "/sessions/{id}/counters"],
  "setCounter": ["PUT", "/counters/{stub}"],
  "setSessionCounter": ["PUT", "/sessions/{id}/counters/{stub}"],
  "resetCounter": ["DELETE", "/counters/{stub}"],
  "resetSessionCounter": ["DELETE", "/sessions/{id}/counters/{stub}"],
  "resetCounters": ["POST", "/counters/reset"],
  "resetSessionCounters": ["POST", "/sessions/{id}/counters/reset"],
  "recordingStatus": ["GET", "/recordings/status"],
  "sessionRecordingStatus": ["GET", "/sessions/{id}/recordings/status"],
  "startRecording": ["POST", "/recordings/start"],
  "startSessionRecording": ["POST", "/sessions/{id}/recordings/start"],
  "stopRecording": ["POST", "/recordings/stop"],
  "stopSessionRecording": ["POST", "/sessions/{id}/recordings/stop"]
}
